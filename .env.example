# SatQuery AI - Environment Configuration
# Copy this file to .env and configure as needed

# Mode: true for zero-key local testing with MockVLM, false for live Google Gemini
DEMO_MODE=true

# Google Gemini API Key (Required only if DEMO_MODE=false)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Selection (e.g., gemini-2.5-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
